{
  "name": "philipwantedagift",
  "version": "1.0.0",
  "private": true,
  "description": "Philip wanted a gift. A private, peek-proof Secret Santa with Google/Apple sign-in, on Cloudflare Workers + D1.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply philipwantedagift --local",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "bash scripts/e2e.sh",
    "check": "npm run lint && npm test && npm run test:e2e",
    "db:migrate:remote": "wrangler d1 migrations apply philipwantedagift --remote",
    "dev:fake-google": "node e2e/fake-oidc.js 8799"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "wrangler": "4.165.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
