# Copy to .dev.vars for local development (never commit .dev.vars).
# Generate APP_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=replace-me-with-32-random-bytes-base64
# Local overrides: print emails to the terminal instead of sending them.
EMAIL_PROVIDER=console
APP_URL=http://localhost:8788
